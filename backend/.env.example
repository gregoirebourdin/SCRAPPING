# Copy to backend/.env — every setting is optional (defaults in app/config.py)

# storage
# LF_DATA_DIR=./data

# fetching
# LF_FETCH_CONCURRENCY=24
# LF_PER_HOST_CONCURRENCY=2
# LF_PER_HOST_MIN_DELAY=0.8
# LF_PROXY_URL=http://user:pass@host:port      # optional, applies to every request + the browser

# search engines
# LF_ENGINES=["google","bing","duckduckgo"]
# LF_SEARCH_MIN_DELAY=2.5                       # seconds between two queries on the same engine
# LF_SEARCH_COUNTRIES=["us","gb","au","ca"]
# LF_ENGINE_COOLDOWN_SECONDS=900

# browser
# LF_BROWSER_ENABLED=true
# LF_BROWSER_EXECUTABLE=/path/to/chromium       # only if `playwright install chromium` is not an option

# qualification
# LF_MIN_LEAD_SCORE=55
# LF_REQUIRE_NAMED_CLIENT=true
# LF_ENGLISH_MIN_CONFIDENCE=0.75

# enrichment
# LF_SMTP_VERIFY=true                           # auto-disabled when port 25 is blocked
# LF_SMTP_HELO_DOMAIN=mail.yourdomain.com       # use a domain you own for polite SMTP checks
# LF_SMTP_FROM_ADDRESS=verify@yourdomain.com
# LF_GUESS_EMAIL_PATTERNS=true
