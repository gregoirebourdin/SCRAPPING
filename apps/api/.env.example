# Scout API — copy to .env (never commit .env). Production values live in Railway variables.
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scout          # Neon pooled URL in production
# DATABASE_DIRECT_URL=postgresql://…                                      # Neon direct URL (migrations, LISTEN/NOTIFY)
INTERNAL_API_SECRET=dev-internal-secret-change-me-32-bytes-minimum!!       # same value as the web app
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# AI (optional: deterministic mode without a key)
# GEMINI_API_KEY=
# AI_PROVIDER=auto

# Discovery / enrichment (optional)
# GITHUB_TOKEN=
# GMAPS_SCRAPER_URL=http://maps-scraper.railway.internal:8080

# Email verification (SMTP only where outbound port 25 is open and the HELO domain is yours)
# VERIFIER_SERVICE_URL=http://email-verifier.railway.internal:8080
# SMTP_ENABLED=false
# SMTP_HELO_DOMAIN=verify.yourdomain.com
# SMTP_FROM_ADDRESS=verify@yourdomain.com

# Web search layer (scout.search): SearXNG first, DuckDuckGo HTML fallback, Gemini grounding only when unresolved
# SEARXNG_URL=http://searxng.railway.internal:8080      # private Railway service (services/searxng); unset = off
# SEARXNG_TIMEOUT=10
# SEARXNG_MAX_CONCURRENCY=4
# SEARXNG_ENGINES=                                      # e.g. bing,brave,duckduckgo (unset = instance defaults)
# SEARCH_PROVIDERS=searxng,duckduckgo                   # web_search discovery source, in order
# SEARCH_LOOKUP_PROVIDERS=searxng                       # people discovery, enrichment research, Gemini pre-check
# SEARCH_MIN_COMPANIES=5                                # Gemini discovery only if free search finds fewer domains
# SEARCH_CACHE_TTL_S=21600
# GEMINI_SEARCH_FALLBACK_ONLY=true                      # false = legacy: Gemini grounding without the free pass
# WEB_RESEARCH_CRAWL_TOP=2                              # result pages fetched before falling back to Gemini
