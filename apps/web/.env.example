# Next.js (Vercel) — never prefix secrets with NEXT_PUBLIC_
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scout   # Neon pooled URL in production
BETTER_AUTH_SECRET=change-me-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
SCOUT_API_URL=http://localhost:8000          # FastAPI (Railway) base URL
INTERNAL_API_SECRET=dev-internal-secret-change-me-32-bytes-minimum!!   # same value as the API
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
